{
  "metadata": {
    "description": "Fixed representative offline dataset for FAO-56 Penman-Monteith ET0 regression testing",
    "provenance": "Extracted from verified 2025 ERA5 reanalysis comparison dataset (daily_comparison.csv)",
    "source_model": "era5",
    "timezone": "Africa/Cairo",
    "units": {
      "temperature_2m_max": "°C",
      "temperature_2m_min": "°C",
      "dew_point_2m_mean": "°C",
      "wind_speed_10m_mean": "m/s",
      "shortwave_radiation_sum": "MJ/m²",
      "et0_fao_evapotranspiration": "mm",
      "precipitation_sum": "mm"
    },
    "calculation_method": "FAO-56 daily Penman-Monteith with standardized grass reference parameters",
    "assumptions": [
      "Soil heat flux G = 0 for daily time steps (FAO-56 Eq. 42)",
      "Wind speed at 10m adjusted to 2m using logarithmic profile u2 = u10 * 4.87 / ln(67.8 * 10 - 5.42) (FAO-56 Eq. 47)",
      "Actual vapour pressure ea derived from mean dewpoint temperature (FAO-56 Eq. 14)",
      "Mean saturation vapour pressure es is average of e0(Tmax) and e0(Tmin) (FAO-56 Eq. 12)",
      "Albedo alpha = 0.23 for standard grass reference surface (FAO-56 Eq. 38)",
      "Ratio Rs/Rso clamped between 0.3 and 1.0 to reflect standard FAO-56 cloudiness factor lower bound (FAO-56 Eq. 39)"
    ]
  },
